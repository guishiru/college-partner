# 大模型配置。复制为 .env 后填入真实值；.env 已在 .gitignore 中，不会进仓库。
#
# 不配置时，需求识别退回纯关键词表——「做信度分析」这类明确说法照常工作，
# 「这几道题一不一致」这类人话识别不出，会走追问。

# none | qwen | fake
LLM_PROVIDER=none

# 千问（阿里云百炼）。在控制台创建 API-KEY 后填这里。
DASHSCOPE_API_KEY=

# 可选：默认 qwen-plus
LLM_MODEL=qwen-plus

# 可选：换厂商时改这里。国内多数厂商提供 OpenAI 兼容端点，
# 通常只需改 base_url 和模型名。
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 可选：单次请求超时秒数，默认 30
LLM_TIMEOUT=30
